          <path
            d="M88.9,72.3 C88.9,68.7 88,66.9 86.5,66.9 C85.1,66.9 84.3,68.4 84,70.4 C83.2,70.9 82.4,71.5 81.9,72.3 Z"
            fill="url(#robe-wash)"
          />
          <path
            d="M81.9,72.3 C80.6,72.2 79.4,72.4 78.5,72.9 C79.6,72.9 80.8,72.7 82,72.6 Z"
            fill="url(#robe-wash)"
            opacity="0.58"
          />
        </g>
      </g>

      <!-- ── the bird ────────────────────────────────────────────────────── -->
      <g
        class="ink-region"
        data-part="bird"
        data-region="bird"
        role="button"
        tabindex="0"
