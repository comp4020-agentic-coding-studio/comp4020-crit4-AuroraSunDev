      <g
        class="ink-region"
        data-part="ziqi"
        data-region="ziqi"
        role="button"
        tabindex="0"
        aria-label={REGIONS[5].label}
      >
        <rect {...hitRect(REGIONS[5].hit)} class="region-hit" />
        <!-- Turned toward Boya, head tipped a little back. The posture of
             someone listening rather than watching. -->
        <g class="figure" fill="#1a1a1a" opacity="0.94">
          <ellipse cx="86.4" cy="65.9" rx="0.82" ry="0.94" transform="rotate(-7 86.4 65.9)" />
