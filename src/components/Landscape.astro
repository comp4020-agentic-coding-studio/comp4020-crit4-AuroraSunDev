      <!-- ── the water running out of the pool ───────────────────────────── -->
      <g
        class="ink-region"
        data-part="stream"
        data-region="stream"
        role="button"
        tabindex="0"
        aria-label={REGIONS[1].label}
      >
        <rect x="0" y="62" width="34" height="26" class="region-hit" />
        <rect x="34" y="63" width="26" height="17" class="region-hit" />
        <rect x="60" y="76" width="46" height="13" class="region-hit" />
        <rect x="106" y="66" width="54" height="26" class="region-hit" />
        <ellipse class="region-breath" cx="20" cy="71" rx="11" ry="8" style="animation-delay: 1.1s" />
        <!-- Water is drawn in broken strokes, never in continuous lines. Long
             unbroken curves across the whole scene read as cable, which is what
             the first pass looked like. -->
        <!-- Water is the unpainted page here too, not a bundle of dark strokes.
             Below the pool it splits: the main course carries right and forward
             out of the bottom corner, and a second arm turns away down the left
             and leaves the picture there. Two exits stop the composition
             draining tidily into one corner. -->
        <g class="stream-water" filter="url(#water-soft)">
          <path
            class="stream-channel"
            d="M30,61.8 C38,61.4 47,61.9 56,63.2 C64,64.6 72,65.6 81,65.4 C90,65.2 99,67 107.5,70.3 C116.5,74 127,79 138,83.4 L160,89.8 L160,92.6 C138,86.4 126.5,81.4 116.5,76.8 C107,72.5 98,70 89,68.7 C80,67.4 71,67.9 62,66.5 C52,65 41,63.6 29,63.9 Z"
          />
          <path
            class="stream-channel"
            d="M29.6,62.4 C25.4,64.2 21,66.4 17,69.4 C12.6,72.8 7.8,76.8 3.8,80 C2.6,80.9 1.4,81.9 0.4,82.7 L0.4,85.2 C1.8,84 3.2,82.8 4.8,81.6 C8.8,78.4 13.4,74.4 17.8,71 C21.8,67.9 26,65.9 30.4,64.2 Z"
          />
        </g>
        <g class="stream-banks" stroke="#4f4f4f" fill="none" stroke-linecap="round" opacity="0.26">
          <path d="M35,61.6 C40,61.4 45,61.8 49,62.6" stroke-width="0.13" />
          <path d="M61,63.7 C67,64.7 73,65.4 78,65.4" stroke-width="0.12" />
          <path d="M94,66.2 C99,67.5 104,69.4 108,71.6" stroke-width="0.12" />
          <path d="M122,77.6 C128,80.1 133,82.2 138,84" stroke-width="0.11" />
          <path d="M41,64.2 C48,64.7 55,65.4 61,66.3" stroke-width="0.11" />
          <path d="M74,67.5 C80,67.9 86,68.3 91,69" stroke-width="0.1" />
          <path d="M104,72 C110,74.3 116,77 121,79.5" stroke-width="0.1" />
          <path d="M20,68.6 C17,70.8 14,73.4 11.4,75.8" stroke-width="0.12" />
          <path d="M13,77 C10.4,79.2 7.8,81.4 5.6,83.2" stroke-width="0.1" />
        </g>
        <!-- A few ripples on the surface, dark on the pale water. -->
        <g class="stream-lines" stroke="#4a4a4a" fill="none" stroke-linecap="round">
          <path d="M38,62.8 C44,62.6 50,63.1 55,64.2" stroke-width="0.18" opacity="0.28" />
          <path d="M58,64.3 C64,65.2 70,65.8 76,65.8" stroke-width="0.16" opacity="0.26" />
          <path d="M83,66.3 C89,66.7 95,68 100,69.8" stroke-width="0.17" opacity="0.25" />
          <path d="M106,72.2 C112,74.7 118,77.4 124,79.9" stroke-width="0.15" opacity="0.22" />
          <path d="M130,82.3 C136,84.4 142,86.5 148,88.3" stroke-width="0.13" opacity="0.19" />
          <path d="M47,64.7 C53,65.1 59,65.8 64,66.5" stroke-width="0.12" opacity="0.2" />
          <path d="M88,68.7 C94,69.8 100,71.5 105,73.5" stroke-width="0.12" opacity="0.18" />
          <path d="M24,66.8 C20.6,68.8 17.2,71.2 14.2,73.6" stroke-width="0.14" opacity="0.22" />
          <path d="M16,72.8 C13,75.2 10,77.8 7.4,80" stroke-width="0.12" opacity="0.18" />
        </g>
      </g>

      <!-- ── the near bank, and the two of them ────────────────────────── -->
      <!-- A painted hill in place of the drawn one. Placed as an <image> inside
           the SVG rather than as an HTML layer over it, for the same reason the
           regions live in here: it scales and crops with the rest of the
           picture instead of sliding around against it.

           Width 160 across the frame, height set from the file's own ratio so
           nothing is stretched, and the base landing on the bottom edge. It
           keeps its alpha — flattening this onto white would put a hard box
           around the hill. -->
      <image
        class="ink-bank"
        pointer-events="none"
        href={boyaAndZiqi.src}
        x="0"
        y="43.9"
        width="160"
        height="56.13"
        preserveAspectRatio="xMidYMax meet"
      />

      <!-- ── 对坐: the two of them, facing each other ────────────────────── -->
      <!-- Middle distance. Big enough that you can see one is holding an
           instrument and the other is not, small enough that they are still two
           people in a landscape rather than a portrait with scenery behind it. -->
      <g
        class="ink-region"
        data-part="boya"
        data-region="boya"
        role="button"
        tabindex="0"
        aria-label={REGIONS[4].label}
      >
        <rect {...hitRect(REGIONS[4].hit)} class="region-hit" />
        <ellipse class="region-breath" {...breathOval(REGIONS[4].hit)} style="animation-delay: 1.7s" />
      </g>

      <g
        class="ink-region"
        data-part="qin"
        data-region="qin"
        role="button"
        tabindex="0"
        aria-label={REGIONS[5].label}
      >
        <rect {...hitRect(REGIONS[5].hit)} class="region-hit" />
        <ellipse class="region-breath" {...breathOval(REGIONS[5].hit)} style="animation-delay: 3.4s" />
      </g>

      <g
        class="ink-region"
        data-part="ziqi"
        data-region="ziqi"
        role="button"
        tabindex="0"
        aria-label={REGIONS[6].label}
      >
        <rect {...hitRect(REGIONS[6].hit)} class="region-hit" />
        <ellipse class="region-breath" {...breathOval(REGIONS[6].hit)} style="animation-delay: 2.8s" />
      </g>

      <!-- ── the bird ────────────────────────────────────────────────────── -->
      <g
        class="ink-region"
        data-part="bird"
        data-region="bird"
        role="button"
        tabindex="0"
        aria-label={REGIONS[3].label}
      >
        <rect {...hitRect(REGIONS[3].hit)} class="region-hit" />
        <ellipse class="region-breath" {...breathOval(REGIONS[3].hit)} style="animation-delay: 0.6s" />
        <g class="bird-flock" stroke="#1f1f1f" fill="none" stroke-linecap="round">
          <g class="bird-wings bird-near">
          <path d="M130,17 C132.4,14.6 134.4,14.2 135.6,16.2" stroke-width="0.5" opacity="0.85" />
          <path d="M135.6,16.2 C137,14.2 139,14.4 141,16.6" stroke-width="0.5" opacity="0.85" />
          </g>
          <g class="bird-wings bird-far">
            <path d="M144,12 C145.4,10.6 146.6,10.4 147.4,11.6" stroke-width="0.32" opacity="0.5" />
            <path d="M147.4,11.6 C148.2,10.4 149.4,10.5 150.6,11.8" stroke-width="0.32" opacity="0.5" />
          </g>
        </g>
      </g>

      <!-- Paper grain, over everything, so the whites are not flat screen white. -->
      <rect class="paper-grain" x="0" y="0" width="160" height="100" filter="url(#grain)" />
    </svg>
  </div>

  <!-- One small ink coordinate system per element: left–right is how fast or
       hard the thing goes, up–down is how loud. Semi-transparent, and only
       there while you are near the thing it belongs to.

       The visible pad is drawn in SVG and dragged with a pointer; the two range
       inputs beside it are the same two values, kept in sync and reachable by
       keyboard and screen reader. A dot you can only drag is not a control
       everybody has. -->
  <div class="pads" data-testid="pads">
    {
      CONTROLS.map((control) => (
        <div
          class="pad"
          data-pad={control.id}
          data-pad-x={control.x}
          data-pad-y={control.y}
          data-pad-dx={control.dx}
          data-shown="false"
          role="group"
          aria-label={`${control.name} controls`}
        >
          <svg class="pad-grid" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <line class="pad-axis" x1="10" y1="90" x2="95" y2="90" />
            <line class="pad-axis" x1="10" y1="5" x2="10" y2="90" />
            <path class="pad-arrow" d="M95,90 L90,87 M95,90 L90,93" />
            <path class="pad-arrow" d="M10,5 L7,10 M10,5 L13,10" />
            <line class="pad-tick" x1="52.5" y1="88" x2="52.5" y2="92" />
            <line class="pad-tick" x1="8" y1="47.5" x2="12" y2="47.5" />
            <circle class="pad-dot" cx="52.5" cy="47.5" r="4.5" />
          </svg>
          <span class="pad-name" aria-hidden="true">{control.name}</span>
          <input
            class="sr-only pad-x"
            type="range"
            min="0"
            max="100"
            value="50"
            data-testid={`pad-${control.id}-rate`}
            aria-label={`${control.name}: ${control.fast} to the right`}
          />
          <input
            class="sr-only pad-y"
            type="range"
            min="0"
            max="100"
            value="50"
            data-testid={`pad-${control.id}-level`}
            aria-label={`${control.name}: volume`}
          />
        </div>
      ))
    }
  </div>

  <!-- What Ziqi says, written into the empty part of the paper the way a
       colophon is. aria-live rather than a dialog: it is a remark, and it
       should reach a screen reader without stealing focus from the painting. -->
  <div class="zhiyin" data-testid="zhiyin" data-shown="false" aria-live="polite">
    <p class="zhiyin-han" lang="zh-Hans" data-testid="zhiyin-han"></p>
    <p class="zhiyin-gloss" data-testid="zhiyin-gloss"></p>
  </div>
</section>
