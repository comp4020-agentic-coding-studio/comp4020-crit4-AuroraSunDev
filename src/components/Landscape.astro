---
// Scene A — one painting, and its subject is the two of them.
//
// The composition is a middle-distance view of Boya and Zhong Ziqi sitting
// facing each other: they sit near the centre, large enough to read as two
// people in conversation, and everything else is arranged around that. An
// earlier pass had them as specks in the bottom corner of a landscape, which
// made the picture about the mountains. It is not about the mountains.
//
// The waterfall shows only its lower half, coming out of the mist band rather
// than starting at a visible top edge. Water emerging from cloud is both how it
// is painted and the only way a fall reads as tall — a fall you can see all of
// is a short one.
//
// The interactive things live inside the SVG rather than as HTML buttons laid
// over it. Two reasons, and the second is the one that matters. First,
// alignment: the painting is scaled to cover whatever viewport it lands in, and
// an overlay positioned in percentages of the frame drifts off the artwork the
// moment the aspect ratio changes. Second, and the point of the scene: the
// drawn thing should *be* the control. Hovering the waterfall darkens the
// waterfall. There is no box around it, no label floating beside it, nothing
// that reads as a widget sitting on top of a picture.
//
// A <g> with role="button" and tabindex="0" is focusable and announced, but it
// does not answer Enter and Space on its own — main.ts adds that. Each group
// carries an invisible hit rect, because a few ink strokes are almost nothing
// to aim at.
//
// Group order is depth, back to front. An earlier pass drew the far bank in
// front of the stream and the picture fell apart into unrelated objects
// floating on a page.

import boyaAndZiqi from "../assets/BoyaAndZiqi.png";

const REGIONS = [
  { id: "waterfall", label: "The waterfall — hear it fall", hit: "24,29 17,34" },
  { id: "stream", label: "The stream — hear it run", hit: "0,64 160,24" },
  { id: "tree", label: "The pine — hear the wind in it", hit: "106,24 46,34" },
  { id: "bird", label: "The bird — hear it sing", hit: "98,10 28,16" },
  { id: "boya", label: "Boya, who is playing — hold the music, or let it go on", hit: "63,57 14,10" },
  { id: "qin", label: "The qin — sit down behind it and play", hit: "62,67 17,7" },
  { id: "ziqi", label: "Zhong Ziqi, who is listening — hear what he heard", hit: "85,59 17,16" },
] as const;

// A pad for each thing that can be turned up or slowed down, anchored beside
// the element it belongs to rather than parked in a corner: the control should
// be found by looking at the thing, not by looking for a control panel.
const CONTROLS = [
  { id: "waterfall", name: "Waterfall", fast: "more water", x: 47, y: 42, dx: 0 },
  { id: "stream", name: "Stream", fast: "faster current", x: 20, y: 71, dx: 0 },
  { id: "tree", name: "Pine", fast: "stronger wind", x: 128, y: 60, dx: 0 },
  { id: "bird", name: "Bird", fast: "quicker calls", x: 112, y: 5, dx: -25 },
  // Beside Boya rather than on the instrument itself — his hit rect runs
  // roughly x63–77, y57–67, so this sits just to his left and a little lower,
  // where the old anchor (down near the far bank) never actually landed.
  { id: "qin", name: "Qin", fast: "quicker phrase", x: 55, y: 72, dx: 0 },
] as const;

function hitRect(hit: string): { x: number; y: number; width: number; height: number } {
  const [origin, size] = hit.split(" ");
  const [x, y] = origin.split(",").map(Number);
  const [width, height] = size.split(",").map(Number);
  return { x, y, width, height };
}

/** The soft bloom that sits under a region, sized from its hit area. */
function breathOval(hit: string): { cx: number; cy: number; rx: number; ry: number } {
  const { x, y, width, height } = hitRect(hit);
  // Capped so a long band does not bloom across the whole picture, and floored
  // so a short one — the qin is a line across a lap — still reads as a glow
  // rather than as a thin lens.
  return {
    cx: x + width / 2,
    cy: y + height / 2,
    rx: Math.min(width * 0.62, 16),
    ry: Math.max(Math.min(height * 0.62, 14), 6),
  };
}
---

<section class="landscape" data-testid="scene-landscape" aria-labelledby="landscape-heading">
  <h2 id="landscape-heading" class="sr-only">The landscape</h2>

  <div class="landscape-frame">
    <svg
      class="landscape-art"
      viewBox="0 0 160 100"
      preserveAspectRatio="xMidYMid slice"
      role="group"
      aria-label="An ink landscape: two figures sitting at a qin, with a waterfall, a stream, a pine and a bird"
    >
      <defs>
        <filter id="ink" x="-15%" y="-15%" width="130%" height="130%">
          <feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="3" seed="7" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="0.9" xChannelSelector="R" yChannelSelector="G" />
        </filter>

        <filter id="soft" x="-25%" y="-25%" width="150%" height="150%">
          <feGaussianBlur stdDeviation="0.9" />
        </filter>

        <filter id="mist-blur" x="-20%" y="-60%" width="140%" height="220%">
          <feGaussianBlur stdDeviation="2.2" />
        </filter>

        <!-- Just enough blur to take the cut edge off the water. A filled
             shape with a crisp boundary reads as sheet metal; a river edge is
             never a line you could draw with a ruler. -->
        <filter id="water-soft" x="-10%" y="-30%" width="120%" height="160%">
          <feGaussianBlur stdDeviation="0.34" />
        </filter>

        <filter id="grain" x="0%" y="0%" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="4" seed="3" />
          <feColorMatrix type="saturate" values="0" />
        </filter>

        <linearGradient id="near-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#1f1f1f" stop-opacity="0.92" />
          <stop offset="55%" stop-color="#454545" stop-opacity="0.66" />
          <stop offset="100%" stop-color="#6b6b6b" stop-opacity="0.34" />
        </linearGradient>

        <linearGradient id="mid-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#3d3d3d" stop-opacity="0.72" />
          <stop offset="60%" stop-color="#6b6b6b" stop-opacity="0.46" />
          <stop offset="100%" stop-color="#8f8f8f" stop-opacity="0.2" />
        </linearGradient>

        <linearGradient id="far-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#767676" stop-opacity="0.52" />
          <stop offset="100%" stop-color="#a8a8a8" stop-opacity="0.1" />
        </linearGradient>

        <!-- The rock the water comes down. Dark and even, because it exists to
             be the thing the fall is *not*. -->
        <linearGradient id="cliff-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#2e2e2e" stop-opacity="0.4" />
          <stop offset="40%" stop-color="#1b1b1b" stop-opacity="0.82" />
          <stop offset="85%" stop-color="#2c2c2c" stop-opacity="0.64" />
          <stop offset="100%" stop-color="#585858" stop-opacity="0.28" />
        </linearGradient>

        <!-- The head of the fall dissolves into the mist instead of starting at
             a ruled edge. A drawn lip of stone was tried and read as a mushroom
             cap on a pillar. -->
        <linearGradient id="fall-emerge" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--paper)" stop-opacity="0" />
          <stop offset="30%" stop-color="var(--paper)" stop-opacity="0.85" />
          <stop offset="60%" stop-color="var(--paper)" stop-opacity="1" />
          <stop offset="100%" stop-color="var(--paper)" stop-opacity="1" />
        </linearGradient>

        <!-- The glow under something you can touch. Ink blooming into wet
             paper rather than a UI highlight — this is the only affordance the
             painting has, since nothing is drawn as a control. -->
        <radialGradient id="breath">
          <stop offset="0%" stop-color="#1a1a1a" stop-opacity="0.26" />
          <stop offset="60%" stop-color="#1a1a1a" stop-opacity="0.09" />
          <stop offset="100%" stop-color="#1a1a1a" stop-opacity="0" />
        </radialGradient>

        <!-- The people get light rather than ink: they are the darkest marks on
             the page and sit on a mid-grey hill, so a bloom of ink under them
             would be invisible. The qin is brighter again, because it is the
             one thing here that leads somewhere else. -->
        <radialGradient id="breath-light">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.62" />
          <stop offset="60%" stop-color="#ffffff" stop-opacity="0.24" />
          <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
        </radialGradient>

        <radialGradient id="breath-bright">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.92" />
          <stop offset="55%" stop-color="#ffffff" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
        </radialGradient>

        <!-- The ground between the far shore and the near bank. It was bare
             paper, which read as a hole rather than as distance. -->
        <linearGradient id="basin-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#a2a2a2" stop-opacity="0" />
          <stop offset="22%" stop-color="#7f7f7f" stop-opacity="0.3" />
          <stop offset="62%" stop-color="#666666" stop-opacity="0.5" />
          <stop offset="100%" stop-color="#5a5a5a" stop-opacity="0.22" />
        </linearGradient>

        <!-- Cloth soaks ink at the hem and holds it at the shoulder. A robe
             filled flat is a paper cut-out; this is what makes it fabric. -->
        <linearGradient id="robe-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#0d0d0d" stop-opacity="0.96" />
          <stop offset="58%" stop-color="#1a1a1a" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#3d3d3d" stop-opacity="0.4" />
        </linearGradient>
      </defs>

      <!-- ── distance ────────────────────────────────────────────────────── -->
      <g class="ink-far" filter="url(#soft)">
        <path
          d="M94,50 L100,42 L105,35 L109,39 L114,30 L119,23 L123,20 L127,26 L131,33 L135,29 L140,35 L146,31 L151,37 L157,41 L160,45 L160,52 L94,52 Z"
          fill="url(#far-wash)"
        />
        <path d="M0,52 L4,46 L9,40 L14,44 L19,48 L24,51 L28,52 Z" fill="url(#far-wash)" />
      </g>

      <!-- ── the cliff the fall comes down ───────────────────────────────── -->
      <g class="ink-cliff" filter="url(#ink)">
        <path d="M20,62 L20.4,52 L21.4,44 L23,38 L22.4,34 L25,30.6 L27.6,26.4 L31.4,25.2 L33.6,28.6 L36.2,31.4 L37,37 L38.4,43 L38.8,50 L39.6,56 L40.4,62 Z" fill="url(#cliff-wash)" />
      </g>

      <!-- ── the range the cliff belongs to ──────────────────────────────── -->
      <!-- Overlapping masses at three weights rather than one silhouette: a
           single closed outline, however carefully notched, keeps resolving
           into a triangle. -->
      <g class="ink-range">
        <path
          class="ink-back"
          filter="url(#soft)"
          d="M-2,56 L1,48 L4,41 L7,34 L10,26 L13,19 L15,15 L17,20 L19,27 L21,24 L23,31 L25,38 L27,45 L29,51 L30,56 Z"
          fill="url(#mid-wash)"
        />
        <path
          class="ink-peak"
          filter="url(#ink)"
          d="M-4,64 L-2,55 L1,47 L3,40 L6,32 L8,24 L10,16 L11.4,10 L13,15 L14.6,22 L16,29 L17.6,25 L19,32 L20.4,39 L21.6,46 L22.6,53 L23.4,64 Z"
          fill="url(#near-wash)"
        />
        <path
          class="ink-spur"
          filter="url(#ink)"
          d="M-4,64 L-2,57 L1,51 L4,46 L6,42 L8,45 L10,50 L13,55 L16,59 L19,62 L21,64 Z"
          fill="url(#near-wash)"
          opacity="0.88"
        />
        <g class="ink-texture" stroke="#2e2e2e" stroke-linecap="round" fill="none">
          <path d="M8,22 C7.4,25 7,27.4 6.6,29" stroke-width="0.42" opacity="0.46" />
          <path d="M11.4,15 C11.2,19 11.2,22.6 11,25" stroke-width="0.4" opacity="0.42" />
          <path d="M14,24 C13.8,27.4 14,30 13.8,32.4" stroke-width="0.34" opacity="0.34" />
          <path d="M4,44 C3.4,47 3.2,49.4 3,51" stroke-width="0.36" opacity="0.3" />
          <path d="M18,32 C17.8,35 18,37.4 17.8,39.4" stroke-width="0.3" opacity="0.26" />
        </g>
      </g>

      <!-- ── the waterfall, lower half only ──────────────────────────────── -->
      <g
        class="ink-region"
        data-part="waterfall"
        data-region="waterfall"
        role="button"
        tabindex="0"
        aria-label={REGIONS[0].label}
      >
        <rect {...hitRect(REGIONS[0].hit)} class="region-hit" />
        <ellipse class="region-breath" {...breathOval(REGIONS[0].hit)} style="animation-delay: 0s" />
        <!-- The water is the paper: this shape carries the page colour and is
             cut out of the dark cliff, so the fall is an absence of ink rather
             than a presence of white. Two earlier attempts painted a pale
             column and both read as a stone obelisk, because a stripe brighter
             than the paper is not something water can be. -->
        <path
          class="fall-water"
          d="M29.8,35 C29.5,42 29.2,49 29,56.4 L33.9,56.4 C33.7,49 33.5,42 33.3,35 Z"
        />
        <g class="fall-streaks" stroke="#8d8d8d" fill="none" stroke-linecap="round">
          <path d="M30.2,36 C30,43 29.9,50 29.8,56" stroke-width="0.15" opacity="0.3" />
          <path d="M31.2,36 C31,43 30.9,50 30.8,56" stroke-width="0.12" opacity="0.24" />
          <path d="M32.2,36 C32.1,43 32.1,50 32.1,56" stroke-width="0.14" opacity="0.27" />
          <path d="M33.2,36 C33.2,43 33.3,50 33.4,56" stroke-width="0.11" opacity="0.2" />
        </g>
        <!-- Where it lands: broken, dry strokes fanning outward. -->
        <g class="fall-spray" stroke="#7d7d7d" fill="none" stroke-linecap="round">
          <path d="M28.4,57.2 C29.8,56.3 32.4,56.2 34.2,56.6" stroke-width="0.26" opacity="0.5" />
          <path d="M26.6,58.8 C29.6,57.6 34.2,57.5 37.2,58.4" stroke-width="0.22" opacity="0.38" />
          <path d="M25.2,60.4 C28.8,59.4 35,59.4 38.8,60.4" stroke-width="0.18" opacity="0.26" />
        </g>
        <!-- Boulders in the plunge pool, so the vertical does not run straight
             into the horizontal with nothing in between. -->
        <g class="fall-rocks" filter="url(#ink)" fill="#2c2c2c">
          <path d="M27.4,58.6 C28.4,57.2 30,57 31,58 C31.6,58.6 31.4,59.4 30.4,59.6 C29,59.9 27.8,59.4 27.4,58.6 Z" opacity="0.62" />
          <path d="M33.2,59.4 C34,58.4 35.4,58.3 36.2,59.1 C36.7,59.6 36.4,60.2 35.6,60.4 C34.4,60.6 33.5,60.1 33.2,59.4 Z" opacity="0.5" />
        </g>
      </g>

      <!-- ── mist ────────────────────────────────────────────────────────── -->
      <!-- The band across the head of the fall is doing a job, not decoration:
           it is what hides the top of the water, so the fall reads as coming
           from somewhere higher than the picture goes. -->
      <g class="ink-mist" filter="url(#mist-blur)" fill="#f5f5f5">
        <ellipse cx="30" cy="34.5" rx="18" ry="2.5" opacity="0.72" />
        <ellipse cx="124" cy="46" rx="40" ry="2.4" opacity="0.5" />
        <ellipse cx="70" cy="57" rx="56" ry="2.4" opacity="0.44" />
      </g>

      <!-- ── the middle distance ─────────────────────────────────────────── -->
      <!-- There was nothing at all between the far range and the near bank, so
           the eye fell into a band of blank paper and the two halves of the
           picture stopped belonging to each other. This is the join: a low
           shore, and a row of trees small enough to read as distance. -->
      <g class="ink-shore" filter="url(#soft)">
        <path d="M34,58.4 C48,56.8 66,56.2 84,56.8 C100,57.4 116,58.6 128,59.8 L128,61.6 C112,60.4 96,59.6 82,59.2 C64,58.8 48,59.2 34,60.2 Z" fill="url(#far-wash)" opacity="0.7" />
      </g>
      <!-- 米点: distant trees are dots, not diagrams. Drawn as a stem plus a
           horizontal crossbar they came out as a row of crucifixes — an
           accidental graveyard across the middle of the painting. At this
           distance a tree is a soft mass over a mark, and nothing else. -->
      <g class="ink-far-trees" fill="#5c5c5c" opacity="0.3">
        <g>
          <ellipse cx="46" cy="55.6" rx="1.15" ry="0.62" />
          <ellipse cx="45.2" cy="56.3" rx="0.75" ry="0.42" />
          <rect x="45.85" y="56.4" width="0.22" height="1.1" />
        </g>
        <g opacity="0.85">
          <ellipse cx="50.2" cy="56.2" rx="0.85" ry="0.48" />
          <rect x="50.1" y="56.6" width="0.18" height="0.9" />
        </g>
        <g>
          <ellipse cx="57" cy="55.4" rx="1.2" ry="0.64" />
          <ellipse cx="58" cy="56.1" rx="0.8" ry="0.44" />
          <rect x="56.9" y="56.2" width="0.22" height="1.1" />
        </g>
        <g opacity="0.8">
          <ellipse cx="61.4" cy="56.1" rx="0.8" ry="0.45" />
          <rect x="61.3" y="56.5" width="0.18" height="0.9" />
        </g>
        <g>
          <ellipse cx="69" cy="55.5" rx="1.1" ry="0.6" />
          <ellipse cx="68.1" cy="56.2" rx="0.7" ry="0.4" />
          <rect x="68.9" y="56.3" width="0.2" height="1" />
        </g>
        <g opacity="0.8">
          <ellipse cx="74" cy="56.2" rx="0.78" ry="0.44" />
          <rect x="73.9" y="56.6" width="0.18" height="0.9" />
        </g>
        <g>
          <ellipse cx="83" cy="55.9" rx="1.1" ry="0.6" />
          <ellipse cx="84" cy="56.5" rx="0.72" ry="0.4" />
          <rect x="82.9" y="56.6" width="0.2" height="1" />
        </g>
        <g opacity="0.78">
          <ellipse cx="88.2" cy="56.5" rx="0.76" ry="0.42" />
          <rect x="88.1" y="56.9" width="0.18" height="0.85" />
        </g>
        <g opacity="0.75">
          <ellipse cx="96" cy="56.6" rx="0.95" ry="0.52" />
          <rect x="95.9" y="57" width="0.18" height="0.95" />
        </g>
        <g opacity="0.7">
          <ellipse cx="101.4" cy="57.1" rx="0.72" ry="0.4" />
          <rect x="101.3" y="57.5" width="0.16" height="0.8" />
        </g>
        <g opacity="0.62">
          <ellipse cx="110" cy="57.7" rx="0.7" ry="0.4" />
          <rect x="109.9" y="58" width="0.16" height="0.75" />
        </g>
      </g>

      <!-- The ground from the far shore forward. It was untouched paper, which
           read as a hole in the middle of the picture rather than as distance;
           a light wash puts a floor under everything and lets the water be the
           only truly white thing down here. -->
      <g class="ink-basin">
        <path d="M0,53 L160,53 L160,94 L0,94 Z" fill="url(#basin-wash)" />
        <g filter="url(#mist-blur)" fill="#f5f5f5">
          <ellipse cx="52" cy="63" rx="34" ry="1.7" opacity="0.28" />
          <ellipse cx="122" cy="66" rx="36" ry="1.8" opacity="0.24" />
          <ellipse cx="86" cy="72" rx="40" ry="1.5" opacity="0.2" />
        </g>
      </g>

      <!-- ── the far bank, and the pine on it ────────────────────────────── -->
      <g class="ink-outcrop" filter="url(#ink)" transform="translate(0,-8)">
        <path d="M106,74 L111,66 L118,60.6 L126,58 L134,59.4 L142,63 L148,68 L152,74 Z" fill="url(#mid-wash)" />
      </g>

      <g
        class="ink-region"
        data-part="tree"
        data-region="tree"
        role="button"
        tabindex="0"
        aria-label={REGIONS[2].label}
      >
        <rect {...hitRect(REGIONS[2].hit)} class="region-hit" />
        <ellipse class="region-breath" {...breathOval(REGIONS[2].hit)} style="animation-delay: 2.2s" />
        <!-- A pine leans. A vertical trunk with branches at even intervals is a
             diagram of a tree; the character of this one is the bend and the
             fact that the branches all reach the same way. -->
        <g class="pine-art">
        <g class="pine-trunk" stroke="#242424" fill="none" stroke-linecap="round">
          <path d="M128.4,60 C127.4,53 128.6,46 126.4,38.4" stroke-width="0.9" />
          <path d="M127.8,51.6 C124.4,50.6 121,49.6 117.6,48.8" stroke-width="0.5" />
          <path d="M127.4,45.4 C130.6,44.2 134.2,43.4 137.4,43" stroke-width="0.45" />
          <path d="M128,55.6 C130.8,55 133.4,54.4 135.6,54.2" stroke-width="0.38" />
          <path d="M127,42 C124.6,41 122.4,40.4 120.4,40.2" stroke-width="0.34" />
        </g>
        <!-- 松针: each cluster is a fan of short strokes from one point, and
             clusters have to overlap or they read as bare twigs — which is
             exactly how the first pass looked, a deciduous sapling in winter. -->
        <g class="pine-needles" stroke="#1f1f1f" fill="none" stroke-linecap="round" stroke-width="0.22">
          <g opacity="0.8">
            <path
              d="M117.6,48.8 L115,46.4 M117.6,48.8 L115.4,47.8 M117.6,48.8 L116,45.8 M117.6,48.8 L117,45.4 M117.6,48.8 L118.6,45.6 M117.6,48.8 L119.6,46.4 M117.6,48.8 L120,47.8 M117.6,48.8 L115.6,49.8"
            />
            <path
              d="M120.6,47.4 L118.4,45 M120.6,47.4 L119.4,44.2 M120.6,47.4 L120.8,44 M120.6,47.4 L122.2,44.4 M120.6,47.4 L123.4,45.4 M120.6,47.4 L123.6,47"
            />
            <path
              d="M123.6,46 L121.6,43.6 M123.6,46 L123,42.8 M123.6,46 L124.6,43 M123.6,46 L126,43.8 M123.6,46 L126.4,45.6"
            />
          </g>
          <g opacity="0.86">
            <path
