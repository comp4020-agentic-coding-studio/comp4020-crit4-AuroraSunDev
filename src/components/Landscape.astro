          <g opacity="0.6">
            <path d="M8,89.8 C7.8,88.4 7.6,87.5 7.4,86.8 M8,89.8 C8.15,88.6 8.3,87.9 8.45,87.4 M8,89.8 C8.5,88.8 8.8,88.2 9.1,87.8" />
