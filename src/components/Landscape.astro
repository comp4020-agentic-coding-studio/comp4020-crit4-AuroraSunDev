---
// Scene A — one painting, not a row of controls.
//
// The interactive things live inside the SVG rather than as HTML buttons laid
// over it. Two reasons, and the second is the one that matters. First,
// alignment: the painting is letterboxed to fit whatever viewport it lands in,
// and an overlay positioned in percentages of the frame drifts off the artwork
// the moment the aspect ratio changes. Second, and the point of the scene: the
// drawn thing should *be* the control. Hovering the waterfall darkens the
// waterfall. There is no box around it, no label floating beside it, nothing
// that reads as a widget sitting on top of a picture.
//
// A <g> with role="button" and tabindex="0" is focusable and announced, but it
// does not answer Enter and Space on its own — main.ts adds that. Each group
// carries an invisible hit rect, because a few ink strokes are almost nothing
// to aim at.
//
// The order of the groups below is the depth of the scene, back to front:
// far range, gorge cliff, the two near ranges, the fall, mist, the far bank
// and its pine, the water, the near bank and the two of them, the bird. An
// earlier pass drew these in an order that put the far bank in front of the
// stream, and the picture fell apart into three unrelated objects floating on
// a page — a near bank bottom-left, a hill bottom-right, and some water
// between them that belonged to neither.

const REGIONS = [
  { id: "waterfall", label: "The waterfall — hear it fall", hit: "38,26 16,36" },
  { id: "stream", label: "The stream — hear it run", hit: "52,60 108,34" },
  { id: "tree", label: "The pine — hear the wind in it", hit: "102,28 42,34" },
  { id: "bird", label: "The bird — hear it sing", hit: "114,5 34,20" },
  { id: "boya", label: "Boya, who is playing — sit down at the qin", hit: "24,68 13,14" },
  { id: "ziqi", label: "Zhong Ziqi, who is listening — hear what he heard", hit: "37,70 16,13" },
] as const;

function hitRect(hit: string): { x: number; y: number; width: number; height: number } {
  const [origin, size] = hit.split(" ");
  const [x, y] = origin.split(",").map(Number);
  const [width, height] = size.split(",").map(Number);
  return { x, y, width, height };
}
---

<section class="landscape" data-testid="scene-landscape" aria-labelledby="landscape-heading">
  <h2 id="landscape-heading" class="sr-only">The landscape</h2>

  <div class="landscape-frame">
    <svg
      class="landscape-art"
      viewBox="0 0 160 100"
      preserveAspectRatio="xMidYMid meet"
      role="group"
      aria-label="An ink landscape: a waterfall, a stream, a pine, a bird, and two figures at a qin"
    >
      <defs>
        <!-- Ink absorbed into paper: the edge of a wet brushstroke is never
             clean. Displacing the whole shape by a little fine noise is a
             cheaper likeness of that than any amount of hand-drawn wobble. -->
        <filter id="ink" x="-15%" y="-15%" width="130%" height="130%">
          <feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="3" seed="7" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="0.9" xChannelSelector="R" yChannelSelector="G" />
        </filter>

        <filter id="soft" x="-25%" y="-25%" width="150%" height="150%">
          <feGaussianBlur stdDeviation="0.9" />
        </filter>

        <filter id="mist-blur" x="-20%" y="-40%" width="140%" height="180%">
          <feGaussianBlur stdDeviation="2.4" />
        </filter>

        <filter id="grain" x="0%" y="0%" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="4" seed="3" />
          <feColorMatrix type="saturate" values="0" />
        </filter>

        <!-- Washes fade toward their base so that air gets between one ridge
             and the next — but only part way. Fading them to nothing turned
             every mountain into a cone floating clear of the ground. -->
        <linearGradient id="near-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#2b2b2b" stop-opacity="0.84" />
          <stop offset="55%" stop-color="#565656" stop-opacity="0.52" />
          <stop offset="100%" stop-color="#7a7a7a" stop-opacity="0.24" />
        </linearGradient>

        <linearGradient id="mid-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#4e4e4e" stop-opacity="0.6" />
          <stop offset="60%" stop-color="#7a7a7a" stop-opacity="0.33" />
          <stop offset="100%" stop-color="#9c9c9c" stop-opacity="0.13" />
        </linearGradient>

        <linearGradient id="far-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#8a8a8a" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#b9b9b9" stop-opacity="0.05" />
        </linearGradient>

        <!-- The foreground has to be the darkest thing in the picture. It was
             the lightest, which read the depth backwards: the near bank looked
             further away than the mountains behind it. -->
        <linearGradient id="fore-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#1c1c1c" stop-opacity="0.88" />
          <stop offset="100%" stop-color="#2e2e2e" stop-opacity="0.78" />
        </linearGradient>

        <!-- The rock the water comes down. Dark and even, because it exists to
             be the thing the fall is *not*. -->
        <linearGradient id="cliff-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#3c3c3c" stop-opacity="0.34" />
          <stop offset="35%" stop-color="#2a2a2a" stop-opacity="0.66" />
          <stop offset="80%" stop-color="#3a3a3a" stop-opacity="0.52" />
          <stop offset="100%" stop-color="#6a6a6a" stop-opacity="0.22" />
        </linearGradient>

        <!-- The head of the fall dissolves into the rock instead of starting at
             a ruled edge. A drawn lip of stone over the top was tried first and
             read as a mushroom cap sitting on a pillar; water coming over a
             ledge is better described by nothing at all than by a wrong line. -->
        <linearGradient id="fall-emerge" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--paper)" stop-opacity="0" />
          <stop offset="22%" stop-color="var(--paper)" stop-opacity="0.8" />
          <stop offset="55%" stop-color="var(--paper)" stop-opacity="1" />
          <stop offset="100%" stop-color="var(--paper)" stop-opacity="1" />
        </linearGradient>
      </defs>

      <!-- ── distance ────────────────────────────────────────────────────── -->
      <g class="ink-far" filter="url(#soft)">
        <path
          d="M88,48 L94,41 L99,34 L103,38 L108,30 L113,23 L117,20 L121,25 L125,32 L129,28 L134,34 L140,30 L146,36 L152,33 L157,39 L160,44 L160,50 L88,50 Z"
          fill="url(#far-wash)"
        />
        <path d="M0,50 L5,45 L10,47 L15,43 L20,46 L26,49 L30,50 L0,50 Z" fill="url(#far-wash)" />
      </g>

      <!-- ── the cliff the fall comes down ───────────────────────────────── -->
      <!-- Drawn before the two ranges so they overlap its edges and it reads as
           the back of a gorge rather than as a third hill parked between them. -->
      <g class="ink-cliff" filter="url(#ink)">
        <path d="M35,60 L36,44 L38,34 L41,27 L45,24 L50,25 L53,32 L55,42 L56,52 L57,60 Z" fill="url(#cliff-wash)" />
      </g>

      <!-- ── the mountain the water comes off ────────────────────────────── -->
      <!-- Built from overlapping masses at three weights rather than one
           silhouette. A single closed outline, however carefully notched, keeps
           resolving into a triangle — the *idea* of a mountain, a pictogram.
           Depth in this kind of painting comes from ridges cutting across each
           other, so that is what these are. -->
      <g class="ink-range">
        <path
          class="ink-back"
          filter="url(#soft)"
          d="M-2,58 L2,50 L7,43 L11,37 L15,29 L18,22 L21,17 L23,21 L26,27 L28,24 L31,31 L34,37 L37,43 L40,48 L42,53 L43,58 Z"
          fill="url(#mid-wash)"
        />
        <path
          class="ink-peak"
          filter="url(#ink)"
          d="M4,62 L7,54 L10,47 L13,40 L16,33 L19,25 L22,17 L24.6,10 L26,7 L27.6,12 L29,19 L30.6,26 L32.4,22 L34,29 L35.6,36 L37,42 L38.6,49 L39.6,55 L40.4,62 Z"
          fill="url(#near-wash)"
        />
        <path
          class="ink-spur"
          filter="url(#ink)"
          d="M-2,62 L1,55 L4,49 L7,44 L10,40 L12,43 L15,48 L18,53 L21,57 L24,60 L26,62 Z"
          fill="url(#near-wash)"
          opacity="0.9"
        />
        <g class="ink-texture" stroke="#2e2e2e" stroke-linecap="round" fill="none">
          <path d="M19,23 C18.4,26 18,28.4 17.6,30" stroke-width="0.45" opacity="0.48" />
          <path d="M23,17 C22.4,21 22.2,24.6 21.8,27" stroke-width="0.4" opacity="0.44" />
          <path d="M26,13 C25.8,17 25.8,20.6 25.6,23" stroke-width="0.42" opacity="0.4" />
          <path d="M29,22 C28.8,25.4 29,28 28.8,30.4" stroke-width="0.34" opacity="0.34" />
          <path d="M13,42 C12.4,45 12.2,47.4 12,49" stroke-width="0.4" opacity="0.32" />
          <path d="M33,29 C32.8,32 33,34.4 32.8,36.4" stroke-width="0.32" opacity="0.28" />
          <path d="M7,48 C6.6,50.4 6.6,52 6.4,53.4" stroke-width="0.34" opacity="0.26" />
        </g>
      </g>

      <!-- The far side of the gorge, in two masses for the same reason. -->
      <g class="ink-mid">
        <path
          class="ink-back"
          filter="url(#soft)"
          d="M54,58 L56,50 L59,42 L62,34 L65,28 L68,33 L72,40 L77,46 L83,51 L89,55 L95,58 Z"
          fill="url(#far-wash)"
        />
        <path
          filter="url(#ink)"
          d="M52,62 L53,54 L54.6,46 L57,38 L59.6,31 L62.4,25 L65,31 L68,38 L71.6,44 L76,49.6 L81.6,54.4 L88,58 L94,60.6 L98,62 Z"
          fill="url(#mid-wash)"
        />
        <g class="ink-texture" stroke="#3a3a3a" stroke-linecap="round" fill="none">
          <path d="M59.6,32 C59.2,35 59.2,37.4 59,39" stroke-width="0.3" opacity="0.32" />
          <path d="M62.8,29 C62.6,32 62.8,34.4 62.6,36" stroke-width="0.28" opacity="0.28" />
          <path d="M66.6,38 C66.6,40.6 66.8,42.6 66.6,44" stroke-width="0.26" opacity="0.24" />
        </g>
      </g>

      <!-- ── the waterfall ───────────────────────────────────────────────── -->
      <g
        class="ink-region"
        data-part="waterfall"
        data-region="waterfall"
        role="button"
        tabindex="0"
        aria-label={REGIONS[0].label}
      >
        <rect {...hitRect(REGIONS[0].hit)} class="region-hit" />
        <!-- The water is the paper. Nothing pale is painted on: this shape is
             filled with the page colour and cut *out* of the dark cliff behind
             it, so the fall is an absence of ink rather than a presence of
             white. Two earlier attempts painted a light column instead, and
             both read as a stone obelisk — because a stripe brighter than the
             paper is not something water can be. -->
        <path
          class="fall-water"
          d="M44.3,23 C43.7,34 43.1,46 42.7,56.6 L48.4,56.6 C48.1,46 47.6,34 47.2,23 Z"
        />
        <g class="fall-streaks" stroke="#8d8d8d" fill="none" stroke-linecap="round">
          <path d="M44.8,31 C44.5,38 44.4,46 44.3,53.4" stroke-width="0.16" opacity="0.3" />
          <path d="M46.6,34 C46.6,41 46.7,48 46.8,54" stroke-width="0.13" opacity="0.22" />
        </g>
        <!-- Where it lands: broken, dry strokes fanning outward. -->
        <g class="fall-spray" stroke="#7d7d7d" fill="none" stroke-linecap="round">
          <path d="M42,57.6 C43.6,56.6 46.4,56.5 48.4,57" stroke-width="0.28" opacity="0.5" />
          <path d="M40,59.4 C43.2,58 48.4,57.9 51.8,58.9" stroke-width="0.24" opacity="0.4" />
          <path d="M38.4,61.2 C42.4,60 49.4,60 53.8,61.1" stroke-width="0.2" opacity="0.28" />
        </g>
      </g>

      <!-- ── mist ────────────────────────────────────────────────────────── -->
      <g class="ink-mist" filter="url(#mist-blur)" fill="#f5f5f5">
        <ellipse cx="48" cy="46" rx="40" ry="2.6" opacity="0.6" />
        <ellipse cx="122" cy="44" rx="40" ry="2.4" opacity="0.55" />
        <ellipse cx="76" cy="60.5" rx="52" ry="2.4" opacity="0.5" />
      </g>

      <!-- ── the far bank, and the pine on it ────────────────────────────── -->
      <!-- Before the stream, so the water passes in front of it: that is what
           makes it the far bank rather than a second foreground. -->
      <g class="ink-outcrop" filter="url(#ink)">
        <path d="M100,72 L105,64 L111,58.6 L118,56 L126,57.4 L134,61 L140,66 L145,72 Z" fill="url(#mid-wash)" />
      </g>

      <g
        class="ink-region"
        data-part="tree"
        data-region="tree"
        role="button"
        tabindex="0"
        aria-label={REGIONS[2].label}
      >
        <rect {...hitRect(REGIONS[2].hit)} class="region-hit" />
        <!-- A pine leans. A vertical trunk with branches at even intervals is a
             diagram of a tree; the character of this one is the bend and the
             fact that the branches all reach the same way. -->
        <g class="pine-trunk" stroke="#242424" fill="none" stroke-linecap="round">
          <path d="M122.4,58 C121.4,51 122.6,44 120.4,36.4" stroke-width="0.9" />
          <path d="M121.8,49.6 C118.4,48.6 115,47.6 111.6,46.8" stroke-width="0.5" />
          <path d="M121.4,43.4 C124.6,42.2 128.2,41.4 131.4,41" stroke-width="0.45" />
          <path d="M122,53.6 C124.8,53 127.4,52.4 129.6,52.2" stroke-width="0.38" />
          <path d="M121,40 C118.6,39 116.4,38.4 114.4,38.2" stroke-width="0.34" />
        </g>
        <!-- 松针: each cluster is a fan of short strokes from one point, and
             clusters have to overlap or they read as bare twigs — which is
             exactly how the first pass looked, a deciduous sapling in winter. -->
        <g class="pine-needles" stroke="#1f1f1f" fill="none" stroke-linecap="round" stroke-width="0.22">
          <g opacity="0.8">
            <path
              d="M111.6,46.8 L109,44.4 M111.6,46.8 L109.4,45.8 M111.6,46.8 L110,43.8 M111.6,46.8 L111,43.4 M111.6,46.8 L112.6,43.6 M111.6,46.8 L113.6,44.4 M111.6,46.8 L114,45.8 M111.6,46.8 L109.6,47.8"
            />
            <path
              d="M114.6,45.4 L112.4,43 M114.6,45.4 L113.4,42.2 M114.6,45.4 L114.8,42 M114.6,45.4 L116.2,42.4 M114.6,45.4 L117.4,43.4 M114.6,45.4 L117.6,45"
            />
            <path
              d="M117.6,44 L115.6,41.6 M117.6,44 L117,40.8 M117.6,44 L118.6,41 M117.6,44 L120,41.8 M117.6,44 L120.4,43.6"
            />
          </g>
          <g opacity="0.86">
            <path
              d="M120.4,36.4 L118,34 M120.4,36.4 L118.6,33.2 M120.4,36.4 L119.8,32.6 M120.4,36.4 L121.4,32.8 M120.4,36.4 L122.8,33.6 M120.4,36.4 L123.4,35.2 M120.4,36.4 L117.4,35.4 M120.4,36.4 L123.6,37"
            />
            <path
              d="M117.2,38.6 L115,36.4 M117.2,38.6 L116,35.6 M117.2,38.6 L117.6,35.4 M117.2,38.6 L119.4,36 M117.2,38.6 L114.8,38.2"
            />
            <path
              d="M123.2,38.4 L125.4,36.2 M123.2,38.4 L124.4,35.4 M123.2,38.4 L122.6,35.2 M123.2,38.4 L126,37.4 M123.2,38.4 L126.4,39.2"
            />
          </g>
          <g opacity="0.76">
            <path
              d="M131.4,41 L133.8,38.8 M131.4,41 L132.6,38 M131.4,41 L131.2,37.6 M131.4,41 L129.4,38.2 M131.4,41 L134.4,40.2 M131.4,41 L134.6,41.8 M131.4,41 L129,41.6"
            />
            <path
              d="M128,41.8 L130,39.4 M128,41.8 L129,38.8 M128,41.8 L127.4,38.6 M128,41.8 L125.6,39.6 M128,41.8 L125.4,42.2"
            />
            <path d="M134.4,42.8 L136.4,40.8 M134.4,42.8 L135.4,40 M134.4,42.8 L137,43.4 M134.4,42.8 L136.6,44.6" />
          </g>
          <g opacity="0.7">
            <path
              d="M129.6,52.2 L131.6,50.2 M129.6,52.2 L130.6,49.4 M129.6,52.2 L128.4,49.6 M129.6,52.2 L132.4,52.4 M129.6,52.2 L132,53.6 M129.6,52.2 L127.2,53"
            />
            <path d="M126.4,52.8 L128,50.6 M126.4,52.8 L127,50 M126.4,52.8 L124.8,50.8 M126.4,52.8 L124.2,53.6" />
          </g>
        </g>
      </g>

      <!-- ── the water running out of the pool ───────────────────────────── -->
      <g
        class="ink-region"
        data-part="stream"
        data-region="stream"
        role="button"
        tabindex="0"
        aria-label={REGIONS[1].label}
      >
        <rect {...hitRect(REGIONS[1].hit)} class="region-hit" />
        <!-- Water is drawn in broken strokes, never in continuous lines. Five
             long unbroken curves across the whole scene read as cable, which is
             what the first pass looked like; the same water in short dashes of
             uneven length and weight reads as a current. -->
        <g class="stream-lines" stroke="#4a4a4a" fill="none" stroke-linecap="round">
          <path d="M54,63.4 C58,63.6 62,64 65.6,64.6" stroke-width="0.34" opacity="0.5" />
          <path d="M69,65.4 C73,66 77.6,66.8 81,67.6" stroke-width="0.3" opacity="0.45" />
          <path d="M85,68.6 C90,69.6 95,70.8 99,72" stroke-width="0.32" opacity="0.42" />
          <path d="M103,73.2 C108,74.6 113,76 117,77.4" stroke-width="0.28" opacity="0.38" />
          <path d="M121,78.8 C127,80.6 133,82.4 138,84" stroke-width="0.3" opacity="0.36" />
          <path d="M142,85.4 C148,87.2 154,89 159,90.6" stroke-width="0.26" opacity="0.3" />

          <path d="M58,66.6 C61.4,67 64.6,67.4 67.4,68" stroke-width="0.24" opacity="0.36" />
          <path d="M72,69 C76,69.8 80,70.6 83.4,71.4" stroke-width="0.22" opacity="0.32" />
          <path d="M88,72.8 C93,74 98,75.2 102,76.4" stroke-width="0.24" opacity="0.3" />
          <path d="M107,78 C112,79.4 117,80.8 121,82.2" stroke-width="0.22" opacity="0.27" />
          <path d="M126,83.6 C132,85.4 138,87.2 143,88.8" stroke-width="0.2" opacity="0.24" />

          <path d="M64,71.4 C68,72.2 72,73 75,73.8" stroke-width="0.18" opacity="0.26" />
          <path d="M80,75.4 C85,76.6 90,77.8 94,79" stroke-width="0.2" opacity="0.24" />
          <path d="M99,80.8 C104,82.2 109,83.6 113,85" stroke-width="0.18" opacity="0.22" />
          <path d="M118,86.6 C124,88.4 130,90.2 135,91.8" stroke-width="0.16" opacity="0.19" />

          <path d="M70,76.4 C74,77.2 77.6,78 80.4,78.8" stroke-width="0.15" opacity="0.18" />
          <path d="M88,82 C93,83.4 97.6,84.8 101,86" stroke-width="0.15" opacity="0.16" />
        </g>
      </g>

      <!-- ── the near bank, and the two of them ──────────────────────────── -->
      <!-- No displacement filter on this one. The faceted top edge kept coming
           out as a smooth loaf, because the noise displacement is about the
           same size as the facets were and simply rounded them off. Bigger
           steps, and the shape left alone to keep them. -->
      <g class="ink-terrace">
        <path
          d="M0,100 L0,88 L6,86.5 L13,84 L19,83 L26,79.8 L34,79.2 L41,80.4 L46,83.2 L49,81.6 L54,86 L57,92 L58,100 Z"
          fill="url(#fore-wash)"
        />
        <g stroke="#0e0e0e" fill="none" stroke-linecap="round">
          <path d="M11,83.4 C10.4,86 10,88.4 9.8,90.4" stroke-width="0.3" opacity="0.3" />
          <path d="M17,82 C16.6,84.6 16.4,86.6 16.2,88.4" stroke-width="0.26" opacity="0.26" />
          <path d="M31,81 C31.4,83.4 31.6,85.4 31.6,87" stroke-width="0.24" opacity="0.22" />
          <path d="M42,84.4 C42.6,86.4 43,88 43.2,89.4" stroke-width="0.22" opacity="0.2" />
        </g>
        <g stroke="#1f1f1f" fill="none" stroke-linecap="round" stroke-width="0.2" opacity="0.5">
          <path d="M22,79.5 C21.7,78.7 21.5,78.3 21.3,78 M22,79.5 C22.1,78.6 22.2,78.2 22.3,77.9" />
          <path d="M36,79.6 C35.8,78.8 35.7,78.4 35.6,78.1 M36,79.6 C36.3,78.8 36.5,78.4 36.7,78.1" />
        </g>
      </g>

      <!-- Both figures are tiny, which is not modesty about the drawing: in a
           landscape this is the size a person is. The whole story is that
           something passed between two specks in all that space. -->
      <g
        class="ink-region"
        data-part="boya"
        data-region="boya"
        role="button"
        tabindex="0"
        aria-label={REGIONS[4].label}
      >
        <rect {...hitRect(REGIONS[4].hit)} class="region-hit" />
        <g class="figure" fill="#141414">
          <ellipse cx="28.2" cy="74.2" rx="0.7" ry="0.78" />
          <path d="M26.7,79.3 C26.7,76.6 27.3,75.2 28.3,75.2 C29.4,75.2 30.1,76.6 30.2,79.3 Z" />
          <path d="M29,76.6 C30.2,76.5 31,76.6 31.6,76.9 L31.4,77.6 C30.7,77.3 29.9,77.2 29,77.3 Z" opacity="0.8" />
        </g>
        <!-- The qin across his lap: one line, which is all it needs to be. -->
        <g stroke="#141414" fill="none" stroke-linecap="round">
          <path d="M26.2,77.6 L33.6,77.2" stroke-width="0.46" opacity="0.9" />
          <path d="M26.6,78.2 L33.2,77.9" stroke-width="0.2" opacity="0.42" />
        </g>
      </g>

      <g
        class="ink-region"
        data-part="ziqi"
        data-region="ziqi"
        role="button"
        tabindex="0"
        aria-label={REGIONS[5].label}
      >
        <rect {...hitRect(REGIONS[5].hit)} class="region-hit" />
        <!-- Turned a little away from the qin and tilted back: the posture of
             someone listening rather than watching. -->
        <g class="figure" fill="#141414" opacity="0.9">
          <ellipse cx="42.6" cy="76.6" rx="0.64" ry="0.72" transform="rotate(-8 42.6 76.6)" />
          <path d="M41.3,81.2 C41.4,78.8 41.9,77.5 42.8,77.5 C43.8,77.5 44.4,78.8 44.5,81.2 Z" />
        </g>
      </g>

      <!-- ── the bird ────────────────────────────────────────────────────── -->
      <g
        class="ink-region"
        data-part="bird"
        data-region="bird"
        role="button"
        tabindex="0"
        aria-label={REGIONS[3].label}
      >
        <rect {...hitRect(REGIONS[3].hit)} class="region-hit" />
        <g class="bird-strokes" stroke="#1f1f1f" fill="none" stroke-linecap="round">
          <path d="M122,17 C124.4,14.6 126.4,14.2 127.6,16.2" stroke-width="0.5" opacity="0.85" />
          <path d="M127.6,16.2 C129,14.2 131,14.4 133,16.6" stroke-width="0.5" opacity="0.85" />
          <path d="M136,12 C137.4,10.6 138.6,10.4 139.4,11.6" stroke-width="0.32" opacity="0.5" />
          <path d="M139.4,11.6 C140.2,10.4 141.4,10.5 142.6,11.8" stroke-width="0.32" opacity="0.5" />
        </g>
      </g>

      <!-- Paper grain, over everything, so the whites are not flat screen white. -->
      <rect class="paper-grain" x="0" y="0" width="160" height="100" filter="url(#grain)" />
    </svg>
  </div>
</section>
