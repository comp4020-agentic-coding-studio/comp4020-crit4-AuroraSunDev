          />
        </g>
      </g>

      <!-- ── the bird ────────────────────────────────────────────────────── -->
      <g
        class="ink-region"
        data-part="bird"
        data-region="bird"
        role="button"
        tabindex="0"
        aria-label={REGIONS[3].label}
      >
