      <!-- ── 对坐: the two of them, facing each other ────────────────────── -->
      <!-- Middle distance. Big enough that you can see one is holding an
           instrument and the other is not, small enough that they are still two
           people in a landscape rather than a portrait with scenery behind it. -->
      <g
        class="ink-region"
        data-part="boya"
        data-region="boya"
        role="button"
        tabindex="0"
        aria-label={REGIONS[4].label}
      >
        <rect {...hitRect(REGIONS[4].hit)} class="region-hit" />
        <g class="figure" fill="#1a1a1a">
          <ellipse cx="70" cy="65.5" rx="0.86" ry="0.98" />
          <circle cx="70" cy="64.2" r="0.38" />
