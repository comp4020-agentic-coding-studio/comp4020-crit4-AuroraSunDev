          </g>
          <g opacity="0.7">
            <path
              d="M135.6,54.2 L137.6,52.2 M135.6,54.2 L136.6,51.4 M135.6,54.2 L134.4,51.6 M135.6,54.2 L138.4,54.4 M135.6,54.2 L138,55.6 M135.6,54.2 L133.2,55"
            />
            <path d="M132.4,54.8 L134,52.6 M132.4,54.8 L133,52 M132.4,54.8 L130.8,52.8 M132.4,54.8 L130.2,55.6" />
