            fill="#121212"
          />
          <!-- the robe, and the hem trailing away downwind of him -->
          <path
            d="M67.5,72 C67.5,68.4 68.5,66.4 70,66.4 C71.4,66.4 72.3,67.9 72.6,70 C73.5,70.5 74.4,71.2 74.9,72 Z"
