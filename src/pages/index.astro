---
import Layout from "../layouts/Layout.astro";
import Guqin from "../components/Guqin.astro";
import Landscape from "../components/Landscape.astro";
import "../styles/landscape.css";
import "../styles/guqin.css";
---

<Layout
  title="高山流水 — High Mountains, Flowing Water"
  description="An ink landscape you can play. Every sound — the qin, the waterfall, the stream, the pine, the bird — is synthesised live in the browser."
>
  <h1 class="inscription">
    <span class="inscription-han" lang="zh-Hans">高山流水</span>
    <span class="inscription-gloss">High Mountains, Flowing Water</span>
  </h1>

  <nav class="scene-nav" aria-label="Scene">
    <button type="button" data-testid="to-landscape" data-scene-to="landscape">The landscape</button>
    <button type="button" data-testid="to-guqin" data-scene-to="guqin">At the qin</button>
  </nav>

  <main class="stage" data-testid="stage" data-scene="landscape" data-phase="still">
    <Landscape />
    <Guqin />
  </main>
</Layout>

<script src="../scripts/main.ts"></script>
