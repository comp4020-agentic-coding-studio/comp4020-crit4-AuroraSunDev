---
import Layout from "../layouts/Layout.astro";
import Guqin from "../components/Guqin.astro";
import Landscape from "../components/Landscape.astro";
import "../styles/landscape.css";
import "../styles/guqin.css";
---

<Layout
  title="高山流水"
  description="伯牙与钟子期的知音故事，做成一幅可以弹奏的水墨山水：每一个声音都由浏览器实时合成。"
>
  <h1 class="inscription">高山流水</h1>

  <nav class="scene-nav" aria-label="场景">
    <button type="button" data-testid="to-landscape" data-scene-to="landscape">山水</button>
    <button type="button" data-testid="to-guqin" data-scene-to="guqin">琴前</button>
  </nav>

  <main class="stage" data-testid="stage" data-scene="landscape" data-phase="still">
    <Landscape />
    <Guqin />
  </main>
</Layout>

<script src="../scripts/main.ts"></script>
